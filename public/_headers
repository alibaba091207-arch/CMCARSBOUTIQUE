# Cloudflare Pages: intestazioni HTTP.
# Demo: niente indicizzazione anche a livello di server (oltre al meta tag).
/*
  X-Robots-Tag: noindex, nofollow
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# File con hash nel nome: cache lunga.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Foto ottimizzate: cache di una settimana.
/images/*
  Cache-Control: public, max-age=604800

# Dati: sempre aggiornati dopo una modifica.
/config.json
  Cache-Control: no-cache
